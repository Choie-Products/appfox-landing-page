RESEND_API_KEY=
RESEND_FROM=Appfox <hello@appfox.app>
# Optional: add contacts to a Resend segment
# RESEND_WAITLIST_SEGMENT_ID=
# Optional: show a "Sign in" link in the header once the product is live
# NEXT_PUBLIC_APP_URL=https://app.appfox.app
# Optional: search engine ownership verification. Paste the token from Google Search Console
# and Bing Webmaster Tools (Bing also feeds DuckDuckGo, Yahoo, and ChatGPT search).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
